{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"${workspaceFolder}/hosts\").inputs.nixpkgs { }"
      },
      "formatting": {
        "command": [
          "nixfmt"
        ]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"${workspaceFolder}/hosts\").nixosConfigurations.d25.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"${workspaceFolder}/hosts\").nixosConfigurations.d25.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}
